{
  "name": "myhoodora-platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test --continue",
    "prepare": "husky",
    "test:e2e:api": "pnpm --filter @myhoodora/api test:e2e",
    "test:e2e:web": "pnpm --filter web test:e2e"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "20.x"
  }
}
