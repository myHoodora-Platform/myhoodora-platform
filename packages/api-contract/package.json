{
  "name": "@myhoodora/api-contract",
  "version": "0.0.0",
  "private": true,
  "description": "Platform-neutral API contract shared by the web and mobile apps: response types, error classification, realtime events, lookups. No DOM, no React Native, no Node APIs.",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./ads": "./src/ads.ts",
    "./errors": "./src/errors.ts",
    "./lookups": "./src/lookups.ts",
    "./push": "./src/push.ts",
    "./auth-errors": "./src/auth-errors.ts",
    "./auth-validation": "./src/auth-validation.ts",
    "./coverage": "./src/coverage.ts",
    "./roles": "./src/roles.ts",
    "./settings": "./src/settings.ts",
    "./support": "./src/support.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@myhoodora/eslint-config": "workspace:*",
    "@myhoodora/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "typescript": "5.9.2",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "zod": "^3.25.76"
  }
}
