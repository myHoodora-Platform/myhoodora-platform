{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_FIREBASE_API_KEY",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID",
    "NEXT_PUBLIC_FIREBASE_APP_ID",
    "MONGODB_URI",
    "FIREBASE_CLIENT_EMAIL",
    "FIREBASE_PRIVATE_KEY",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "GEOCODE_MAPS_CO_API_KEY",
    "FIREBASE_PROJECT_ID",
    "CORS_ORIGIN",
    "APP_URL",
    "RESEND_API_KEY",
    "RESEND_WEBHOOK_SECRET",
    "MAIL_FROM",
    "MAIL_REPLY_TO",
    "TEST_MONGO_URI",
    "MONGO_AUTO_INDEX",
    "SWAGGER_ENABLED",
    "REDIS_URL",
    "REALTIME_BUS",
    "REALTIME_ENV", "NEARBY_BUFFER_M", "STORAGE_PROVIDER", "CLOUDINARY_URL", "STORAGE_DIRECT_UPLOADS", "STORAGE_MAX_CONCURRENT_UPLOADS", "EVENT_REMINDERS_ENABLED"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "dev": {
      "env": [
        "PORT"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
