# myHoodora web (Next.js). Copy to .env.local and fill in.
# Everything prefixed NEXT_PUBLIC_ is bundled into the browser: never put a secret in one.
# Server secrets (database, Firebase Admin, email, storage) belong to the API: see apps/api/.env.example.

# ── Firebase web app ─────────────────────────────────────────────────────────
# Firebase Console → Project settings → General → Your apps → Web app. These identify the project; they are not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Google sign-in (optional) ────────────────────────────────────────────────
# The OAuth *web client ID* of the Firebase project's Google provider
# (Firebase Console → Authentication → Sign-in method → Google → Web SDK configuration).
# Turns on Google's "Continue as …" One Tap prompt for signed-out visitors. Leave empty to turn it off;
# the "Continue with Google" button works either way. The site's origin must be listed under
# "Authorised JavaScript origins" for this client in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── URLs ─────────────────────────────────────────────────────────────────────
# The API (NestJS), including the /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# This site's public origin: used for canonical URLs, link previews, robots.txt and the sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Modes ────────────────────────────────────────────────────────────────────
# true = run on in-browser sample data with no API. There is no server-side page gate in this mode:
# never use it for a real deployment.
NEXT_PUBLIC_USE_MOCKS=false

# ── Server-side only (no NEXT_PUBLIC_ prefix) ────────────────────────────────
# Address lookup during onboarding (/api/geocode). Free key from https://geocode.maps.co
GEOCODE_MAPS_CO_API_KEY=
