# Copy to .env.local (git-ignored). Every EXPO_PUBLIC_ value is compiled into the app: never a secret.
# Variables are documented in docs/mobile/README.md.

# development | preview | production
EXPO_PUBLIC_APP_ENV=development
# The API, including /api. A phone can't reach "localhost": use your computer's LAN address, or staging.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001/api
# The web app's origin, for its address lookups (/api/geocode) and for links (Terms, Privacy).
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:3000

# The Firebase web app's config (same project and values as the web's NEXT_PUBLIC_FIREBASE_*). Public identifiers.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in. Web client: the OAuth web client of the Firebase Google provider (the web's NEXT_PUBLIC_GOOGLE_CLIENT_ID).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client: register the iOS app (com.myhoodora.app) in Firebase; CLIENT_ID from its GoogleService-Info.plist. Needs a new native build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Crash reporting (Sentry): the project's DSN (public by design). Reporting runs only in preview and
# production builds; leave empty locally.
EXPO_PUBLIC_SENTRY_DSN=

# Settings → Diagnostics (send a test error, crash the app), for checking crash reporting. "true" in
# the EAS preview environment only; production builds never show it, whatever this says.
EXPO_PUBLIC_QA_TOOLS=

# Sentry source-map upload, read at build time only (never compiled into the app). Set in EAS:
# SENTRY_ORG and SENTRY_PROJECT as plain variables, SENTRY_AUTH_TOKEN as a SECRET. Never put the
# token in this file or in git. Local builds skip the upload (SENTRY_DISABLE_AUTO_UPLOAD in package.json).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Firebase native config files: NOT env values, and never committed. Download from Firebase console →
# Project settings → Your apps, and save as apps/mobile/google-services.json and
# apps/mobile/GoogleService-Info.plist (git-ignored). EAS builds read them from EAS file variables
# instead (paths are set by EAS; leave these unset locally):
# GOOGLE_SERVICES_JSON=
# GOOGLE_SERVICE_INFO_PLIST=
