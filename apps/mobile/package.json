{
  "name": "@myhoodora/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "expo start --dev-client",
    "device:link": "sh scripts/keep-device-linked.sh",
    "start": "expo start",
    "android": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:android",
    "ios": "EXPO_USE_PRECOMPILED_MODULES=0 SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "doctor": "expo install --check && npx --yes expo-doctor",
    "export:check": "expo export --platform android --platform ios --output-dir .expo/export-check",
    "eas:build": "eas build"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@firebase/auth": "1.13.3",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@myhoodora/api-contract": "workspace:*",
    "@myhoodora/design-tokens": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~57.0.31",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.14.0",
    "lucide-react-native": "^1.60.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "rn-emoji-keyboard": "1.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@sentry/cli": "2.58.4",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.11",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.6",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./src/test/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "testTimeout": 20000,
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    }
  }
}
