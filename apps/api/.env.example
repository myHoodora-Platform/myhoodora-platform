# ============================================================
#  MyHoodora Backend — Environment Variables
# ============================================================

# ────────────────────────────────────────────────
# Application
# ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ────────────────────────────────────────────────
# MongoDB
# ────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/myhoodora

# ────────────────────────────────────────────────
# Firebase Admin SDK
# Either point to a service-account JSON file …
# ────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# … or provide the path to the downloaded service-account file
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# ────────────────────────────────────────────────
# Web session cookie (POST /auth/session). Days, 7 by default; Firebase allows 5 minutes to 14 days.
# ────────────────────────────────────────────────
# SESSION_COOKIE_TTL_DAYS=7

# ────────────────────────────────────────────────
# JWT / Auth (optional — used if you issue your own tokens)
# ────────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# ────────────────────────────────────────────────
# CORS
# ────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ────────────────────────────────────────────────
# Web app URL (links in emails, e.g. /verify-email)
# ────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ────────────────────────────────────────────────
# Email (Resend). Leave RESEND_API_KEY empty in dev: emails are logged
# (masked) instead of sent. Use a *sending-only* key restricted to the
# myhoodora.com domain (mail.myhoodora.com once verified). Never expose these to the web app.
# ────────────────────────────────────────────────
RESEND_API_KEY=
# Signing secret of the Resend webhook pointing at /api/webhooks/resend (whsec_…)
RESEND_WEBHOOK_SECRET=
MAIL_FROM="myHoodora <hello@myhoodora.com>"
# MAIL_REPLY_TO=hello@myhoodora.com

# ────────────────────────────────────────────────
# Operations
# ────────────────────────────────────────────────
# Expose Swagger at /api/docs in production (always on in development)
# SWAGGER_ENABLED=true
# Mongoose creates missing indexes at boot; set false once Atlas manages them
# MONGO_AUTO_INDEX=true

# ── Realtime (live updates across API instances; docs/api-contract.md §19) ──
# Redis with PUBLISH rights, e.g. Upstash: rediss://default:<password>@<host>:6379
# Empty → MongoDB change streams, then in-memory (single instance only).
REDIS_URL=
# auto (default) | redis | mongo | memory
REALTIME_BUS=auto
# Separates environments that share Redis/Mongo (defaults to NODE_ENV).
REALTIME_ENV=

# Join a nearby Hood (contract §16): how far outside a Hood's edge an address can be and still ask to join. Default 3000.
NEARBY_BUFFER_M=

# File storage (contract §20). Server-side only: never expose these to the web app.
# STORAGE_PROVIDER picks the adapter (cloudinary today). Without CLOUDINARY_URL, uploads answer 503.
STORAGE_PROVIDER=cloudinary
# From the Cloudinary console → API Keys: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Files one API instance sends to storage at once (more wait briefly, then 503 "try again"). Default 4.
STORAGE_MAX_CONCURRENT_UPLOADS=
# Browser → storage video uploads. Off by default: each costs a Cloudinary Admin API call (hourly quota on the free plan).
STORAGE_DIRECT_UPLOADS=false

# Event reminders and follow-ups (contract §23). On by default; set false to pause the scheduler.
EVENT_REMINDERS_ENABLED=
