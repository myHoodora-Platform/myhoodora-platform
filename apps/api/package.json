{
  "name": "@myhoodora/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "turbo build && node dist/main",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config ./jest.config.json",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "seed:neighborhoods": "ts-node src/database/seed-neighborhoods.ts",
    "migrate": "node --env-file=.env -r ts-node/register src/database/migrate.ts",
    "migrate:dry": "node --env-file=.env -r ts-node/register src/database/migrate.ts --dry-run"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "mongodb": "^7.6.0",
    "mongoose": "^9.6.3",
    "reflect-metadata": "^0.1.13",
    "resend": "^6.30.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@myhoodora/eslint-config": "workspace:*",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
